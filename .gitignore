# --------------------------------------------------
# macOS metadata
# --------------------------------------------------
.DS_Store

# --------------------------------------------------
# Xcode user-specific files
# Local UI state, breakpoints, and personal settings.
# Do not share these in Git.
# --------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# User-specific data inside Xcode project/workspace bundles
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/

# --------------------------------------------------
# Build output
# Generated locally by Xcode.
# --------------------------------------------------
build/
DerivedData/
.derivedData/

# --------------------------------------------------
# App archives and debug symbol artifacts
# --------------------------------------------------
*.ipa
*.dSYM
*.dSYM.zip

# --------------------------------------------------
# Swift Playgrounds
# --------------------------------------------------
timeline.xctimeline
playground.xcworkspace

# --------------------------------------------------
# Fastlane generated artifacts
# --------------------------------------------------
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# --------------------------------------------------
# Editor / temporary files
# --------------------------------------------------
*.swp
*.lock
docs/

# --------------------------------------------------
# AI agent tooling
# Per-developer setup — see AGENTS.md for install steps.
# Only AGENTS.md and CLAUDE.md are tracked; everything
# else agent-related stays local so the repo stays clean.
# --------------------------------------------------
.claude/
.agents/
.agent/
.codex/
.cursor/
.gemini/
.mcp.json
.gemini-swarm/
skills-lock.json

# --------------------------------------------------
# Secrets files
# --------------------------------------------------
Secrets.swift
.env
Config/Secrets.xcconfig

# --------------------------------------------------
# Agent-generated reports
# Local working documents, not part of the codebase.
# --------------------------------------------------
CODE_AUDIT.md
